# Database (Neon Serverless Postgres)
DATABASE_URL=postgres://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Site Information & Localization
SITE_URL=https://freshangle.vercel.app
SITE_NAME=Fresh Angle
DEFAULT_TIMEZONE=Asia/Kolkata

# Creator Configuration (Reused across all sites)
CREATOR_NAME=Venkatesh K S
CREATOR_URL=https://venkatesh-k-s.vercel.app
CREATOR_IMAGE=/images/creator.png

# AI Providers (At least GEMINI and GROQ required for resilient fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
EMBEDDING_PROVIDER=none

# Image Generation & Stock Photos
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
PEXELS_API_KEY=your_pexels_api_key

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=fresh-angle/covers
IMAGE_FALLBACK=default_image

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_THREAD_ID=

# Security & Admin Access
CRON_SECRET=generate_a_random_32_char_secret_for_cron
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
SESSION_SECRET=generate_a_random_32_char_secret_for_session_encryption

# Automation & Dispatch
GITHUB_REPO=KSVenkatesh2002/Fresh-Angle
GITHUB_DISPATCH_TOKEN=
AUTO_PUBLISH=true

# Optional Integration Variables
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
RESEND_API_KEY=
NEWS_API_PROVIDER=
NEWS_API_KEY=
